# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Os builds em pasta separada: `.next-novo` e do deploy (que constroi ao lado
# e so troca no fim) e `.next-teste` e o build de conferencia. Sao saida de
# build, como o `.next` -- e sem esta linha o primeiro `git add -A` depois de
# um deles arrasta o diretorio inteiro para dentro do commit.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (nunca comite credenciais reais)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs do PM2 na VPS
/logs

# a colagem de migrations para o SQL Editor: saida de
# scripts/migrations-pendentes.sh, e copia do que ja esta versionado em
# supabase/migrations/. Copia de SQL versionado dentro do repositorio e a
# receita para alguem editar a copia.
/pendentes

# a mesma colagem, copiada para a raiz so para o app conseguir abri-la (ele so
# enxerga arquivos dentro do diretorio de trabalho). Pela mesma razao acima:
# copia de SQL versionado nao entra no repositorio.
/aplicar-no-supabase-*.sql

# imagens geradas por `npm run prototipo`
/prototipos
/.prototipo
# a captura e a pagina unica do prototipo clicavel: saida, nao fonte
/.captura
/prototipo-full-hub.html
