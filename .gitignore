# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (nunca comite credenciais reais)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs do PM2 na VPS
/logs

# imagens geradas por `npm run prototipo`
/prototipos
/.prototipo
# a captura e a pagina unica do prototipo clicavel: saida, nao fonte
/.captura
/prototipo-full-hub.html
